# Source distribution contents beyond the package itself.
#
# examples/ is deliberately NOT included: the sdist ships the installable package
# only (the wheel installs just the pygpgpu package either way). The numbered
# scripts remain the project's end-to-end smoke tests and stay in the repository.
include README.md
include README.zh-CN.md
include LICENSE

# doc/ is deliberately not included: it holds vendor reference PDFs for the CUDA
# driver API and NVRTC guides, not project documentation.
